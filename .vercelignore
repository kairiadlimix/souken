# Vercelデプロイ時に除外するファイル
# Serverless Functionのサイズ制限（250MB）を超えないようにするため

# PDFファイル（サンプルデータ）
*.pdf

# Pythonキャッシュ
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/

# 仮想環境
venv/
env/
ENV/
.venv/

# ビルド成果物
build/
dist/
wheels/
*.egg

# ドキュメント（大きなファイル）
*.md
!README.md

# CSVファイル（大きなファイル）
*.csv

# テストファイル
test_*.py
*_test.py
test_check.py
test_gemini_ocr.py

# 開発用スクリプト
実現可能性評価_質問リスト_*.py
*_CSV生成.py

# Streamlitアプリ（Vercelでは使用しない）
app.py
run_local.py

# Gemini OCR関連（Vercelでは動作しない）
src/gemini_ocr.py
Gemini_OCR*.md

# srcディレクトリ内の不要なファイル
src/main.py
src/__pycache__/

